<%- include('../header.ejs') %>

<div class="w3-padding-16">
    <table class="w3-table w3-bordered w3-hoverable" id="list" style="text-align: left; position:relative;">
        <thead>
            <tr class="w3-gray">
                <th style="width:100px;" onclick="sortColumns(0,columnLabels[0])">Date</th>
                <th onclick="sortColumns(1,columnLabels[1])">Line</th>
                <th onclick="sortColumns(2,columnLabels[2])">UnitID</th>
                <th onclick="sortColumns(3,columnLabels[3])">Part Number</th>
                <th onclick="sortColumns(4,columnLabels[4])">Desciption</th>
                <th style="width:100px;" onclick="sortColumns(5,columnLabels[5])">Due Date</th>
                <th onclick="sortColumns(6,columnLabels[6])">Qty</th>
                <th onclick="sortColumns(7,columnLabels[7])">Buyer</th>
                <th onclick="sortColumns(8,columnLabels[8])">Requestor</th>
            </tr>
        </thead>
        <tbody>
            <% products.forEach(product => { %>
                <tr>
                    <td><%= product.DateTime.slice(0,11)%></td>
                    <td><%= product.Line %></td>
                    <td><%= product.UnitID %></td>
                    <td><%= product.PartNumber %></td>
                    <td><%= product.Description %></td>
                    <td><%= product.DueDate%></td>
                    <td><%= product.Qty%></td>
                    <td><%= product.Buyer%></td>
                    <td><%= product.requestorName%></td>
                </tr>
            <% }) %>
        </tbody>
    </table>

</div>

<script src="/ui/js/filter.js"></script>
<%- include('../scripts.ejs') %>
<%- include('../footer.ejs') %>