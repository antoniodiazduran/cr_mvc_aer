function getCheckboxValue(va) {
	strw = window.document.getElementById('chkbox').value;
  const editRecord = window.document.getElementById("edit");
  const chkBoxID = window.document.getElementById('chkbox');

	if (va.checked) { 
	  console.log('checked');
    if (!strw.includes(va.value)) {
      chkBoxID.value += va.value +",";
      strw += va.value+",";
      if(editRecord) { editRecord.style.display="block"; }
    }
	} else { 
    console.log('unchecked');
    strw = strw.replace(va.value+',',''); 
    chkBoxID.value = strw;		
	}
	if (!strw.length) { editRecord.style.display="none" }

  console.log('v:'+chkBoxID.value);
  console.log('f:'+strw);
}
</script>