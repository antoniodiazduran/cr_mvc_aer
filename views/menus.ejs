    <span class="w3-right"> <%= rowcount%></span>
    <div class="w3-bar-item w3-right" style="display:none" id="add"><a href="<%=breadcrumbs%>/add"><i class="material-icons">add</i></a></div>        
        <div style="display:none" id="edit">
            <div class="w3-bar-item w3-right" id="editrc"><a href="" onClick="buttonEdit();"><i class="material-icons" >edit</i></a></div>  
         
            <% if(typeof nArrays !== 'undefined') {%>
                <% Object.values(nArrays).forEach((doc)=>{ %>
                    <%let names = doc.split(",");%>
                    <div class="w3-bar-item w3-right" id="<%=names[0]%>"><a href="" title="<%=names[0]%>" onClick="buttonArrays('array_<%=names[0]%>');"><i class="material-icons" ><%=names[1]%></i></a></div>  
                <% }); %>
            <% } %>
        </div>
        
</div>