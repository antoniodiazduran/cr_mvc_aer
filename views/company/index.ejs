<%- include('../header.ejs') %>

<div class="w3-padding-16">
    <table class="w3-table w3-bordered w3-hoverable" id="list" style="text-align: left; position:relative;">
        <thead>
            <tr class="w3-teal">
                <th onclick="sortColumns(0,columnLabels[0])">Name</th>
                <th onclick="sortColumns(1,columnLabels[1])">ZipCode</th>
                <th onclick="sortColumns(2,columnLabels[2])">Symbol</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            <% company.forEach(cmpy => { %>
                <tr>
                    <td><%= cmpy.companyname%></td>
                    <td><%= cmpy.zipcode %></td>
                    <td><%= cmpy.symbol %></td>
                    <td><input type="checkbox" name="choosedate" value="<%= cmpy._id%>" onClick="getCheckboxValue(this)"></td>
                </tr>
            <% }) %>
        </tbody>
    </table>

</div>

<input type="hidden" id="sect" name="sect" value="<%=section%>">
<input type="hidden" id="chkbox" name="chkbox">
<script>
    document.getElementById("add").style.display="block";
</script>
<script src="/ui/js/filter.js"></script>
<%- include('../scripts.ejs') %>
<%- include('../footer.ejs') %>